# Copy to .env.mobile on your server. Do not commit real credentials.
DEVFLOW_DOMAIN=devflow.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-admin-password
DEVFLOW_MODE=live
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=
GITHUB_TOKEN=
GITHUB_WRITE_ENABLED=false
GITHUB_WEBHOOK_ENABLED=false
# Start with keyword retrieval; local Milvus/Embedding need a separate migration.
RETRIEVAL_BACKEND=keyword
