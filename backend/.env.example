# demo: explicit fixture data and rule-based output. live: GitHub + model.
DEVFLOW_MODE=demo
DATABASE_URL=sqlite:///./data/devflow.db
GITHUB_TOKEN=
GITHUB_WRITE_ENABLED=false
# Optional signed webhook inbox; independent 32+ character secret and local repository IDs.
GITHUB_WEBHOOK_ENABLED=false
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_REPOSITORY_IDS=
# Default loopback-only local mode. Set a unique 12+ character password before enabling login.
AUTH_ENABLED=false
AUTH_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=4096
# Optional manual prices per million tokens; missing values mean unknown cost.
# LLM_INPUT_PRICE_PER_MILLION=0
# LLM_OUTPUT_PRICE_PER_MILLION=0
# LLM_CACHED_INPUT_PRICE_PER_MILLION=0
LLM_PRICE_CURRENCY=CNY
# Independent random token (32+ characters), never reuse a model or GitHub key.
MCP_ACCESS_TOKEN=
# Comma-separated local repository IDs, not owner/repository names.
MCP_REPOSITORY_IDS=
# DeepSeek: none disables thinking; low/high/max enable thinking.
# Leave unset for a provider without this parameter.
# LLM_REASONING_EFFORT=none
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_AGENT_STEPS=6
WORKSPACE_ROOT=./data/code
WORKSPACE_MAX_FILES=500
WORKSPACE_MAX_FILE_BYTES=256000
WORKSPACE_MAX_TOTAL_BYTES=8000000
LOCAL_PROJECT_ENABLED=true
WORKFLOW_MAX_TASKS=6
AGENT_CONCURRENCY=2
AGENT_TIMEOUT_SECONDS=120
MAX_REPLANS=1
MAX_RESUME_ATTEMPTS=3
WORKER_CONCURRENCY=2
QUEUE_POLL_SECONDS=0.5
JOB_LEASE_SECONDS=30

# BM25 works without an embedding service. Milvus uses hybrid BM25/vector + RRF.
RETRIEVAL_BACKEND=keyword
CHUNK_SIZE=1000
CHUNK_OVERLAP=120
EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_LOCAL=false
# Set only when the provider supports custom dimensions.
# EMBEDDING_DIMENSIONS=1024
MILVUS_URI=http://127.0.0.1:19530
MILVUS_DEPLOYMENT=standalone
MILVUS_TOKEN=
MILVUS_COLLECTION=devflow_knowledge
RERANK_ENABLED=false
RERANK_BASE_URL=https://api.jina.ai/v1
RERANK_API_KEY=
RERANK_MODEL=
