# Optional Docker Compose config. Local Python development reads backend/.env.
DEVFLOW_MODE=demo
POSTGRES_PASSWORD=devflow-local
GITHUB_TOKEN=
GITHUB_WRITE_ENABLED=false
GITHUB_WEBHOOK_ENABLED=false
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_REPOSITORY_IDS=
AUTH_ENABLED=false
AUTH_COOKIE_SECURE=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_MAX_TOKENS=4096
# Optional manual prices per million tokens; leave unset when unknown.
# LLM_INPUT_PRICE_PER_MILLION=0
# LLM_OUTPUT_PRICE_PER_MILLION=0
# LLM_CACHED_INPUT_PRICE_PER_MILLION=0
LLM_PRICE_CURRENCY=CNY
MCP_ACCESS_TOKEN=
MCP_REPOSITORY_IDS=
WORKFLOW_MAX_TASKS=6
AGENT_CONCURRENCY=2
AGENT_TIMEOUT_SECONDS=120
MAX_REPLANS=1
MAX_RESUME_ATTEMPTS=3
WORKER_CONCURRENCY=2
QUEUE_POLL_SECONDS=0.5
JOB_LEASE_SECONDS=30
RETRIEVAL_BACKEND=keyword
EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_LOCAL=false
MILVUS_URI=http://host.docker.internal:19530
MILVUS_DEPLOYMENT=standalone
MILVUS_TOKEN=
MILVUS_COLLECTION=devflow_knowledge
RERANK_ENABLED=false
RERANK_BASE_URL=https://api.jina.ai/v1
RERANK_API_KEY=
RERANK_MODEL=
